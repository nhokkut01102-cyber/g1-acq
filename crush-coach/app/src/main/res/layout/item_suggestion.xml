<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/card_suggestion"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/styleTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/tag_bg"
        android:paddingHorizontal="8dp"
        android:paddingVertical="2dp"
        android:textColor="@color/pink_deep"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/suggestionText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/ink"
        android:textSize="16sp" />

    <TextView
        android:id="@+id/whyText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/ink_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnCopy"
            style="@style/PillButton.Outline"
            android:text="@string/copy" />

        <TextView
            android:id="@+id/btnInsert"
            style="@style/PillButton.Filled"
            android:layout_marginStart="8dp"
            android:text="@string/insert" />
    </LinearLayout>
</LinearLayout>
